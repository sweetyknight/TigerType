{
  "description": "固定公开输入，仅用于独立引擎基线；不是原小狼毫的候选金标准。网址启动器不在此工具中执行。",
  "cases": [
    {"id": "tiger-short", "schema": "tiger", "input": "u", "first": "的", "page_size": 9},
    {"id": "tiger-full", "schema": "tiger", "input": "uni", "first": "的"},
    {"id": "tigress-phrase", "schema": "tigress", "input": "jxbh", "first": "你好"},
    {"id": "pinyin", "schema": "PY_c", "input": "nihao", "contains": "你好"},
    {"id": "pinyin-reverse", "schema": "tiger", "input": "`nihao", "contains": "你好"},
    {"id": "stroke-reverse", "schema": "PY_c", "input": "`h", "min_candidates": 1},
    {"id": "english", "schema": "tiger", "input": "'hello", "contains": "hello"},
    {"id": "quick-symbol", "schema": "tiger", "input": ";a", "commit": "！"},
    {"id": "date", "schema": "tiger", "input": "/date", "min_candidates": 1},
    {"id": "time", "schema": "tiger", "input": "/time", "min_candidates": 1},
    {"id": "week", "schema": "tiger", "input": "/week", "min_candidates": 1},
    {"id": "number", "schema": "tiger", "input": "S123", "contains": "壹佰贰拾叁"},
    {"id": "calculator", "schema": "tiger", "input": "=1+2", "contains": "1+2=3"},
    {"id": "unicode", "schema": "tiger", "input": "u", "options": {"udpf_switch": true}, "comment_contains": "U+7684"},
    {"id": "charset", "schema": "tiger", "input": "u", "options": {"charset_comment_filter": true}, "comment_nonempty": true},
    {"id": "pinyin-comment", "schema": "tiger", "input": "u", "options": {"pinyin": true}, "comment_nonempty": true},
    {"id": "decomposition", "schema": "tiger", "input": "u", "options": {"chaifen": true}, "comment_nonempty": true},
    {"id": "traditional", "schema": "tiger", "input": "kry", "options": {"simplification": true}, "first": "漢"},
    {"id": "emoji", "schema": "tiger", "input": "rtm", "options": {"emoji_cn": true}, "contains": "😀"},
    {"id": "non-bmp", "schema": "tiger", "input": "fgfa", "options": {"extended_char": false}, "contains": "𠀀"}
  ]
}
